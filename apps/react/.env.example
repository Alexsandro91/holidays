# Le variabili VITE_* finiscono nel bundle del browser: sono pubbliche, mai segreti

# Nome dell'app (titolo della pagina e UI)
VITE_APP_NAME=Holidays

# URL base del backend Laravel (Sail risponde sulla porta 80)
VITE_API_URL=http://localhost

# Porta del dev server Vite (letta solo da vite.config.ts, non esposta al browser)
DEV_SERVER_PORT=5173
